<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Smile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/smile_white</item>
        <item name="android:navigationBarColor">@color/smile_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Smile.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/smile_white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Smile</item>
    </style>
</resources>
